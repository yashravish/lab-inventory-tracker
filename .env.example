# Copy this file to .env at the project root and fill in your values.
# The backend's DotenvEnvironmentPostProcessor loads it automatically at startup.

# Anthropic API key for the "Ask your inventory" feature.
# Without a key the backend runs in mock mode (regex parser) — no signup needed.
ANTHROPIC_API_KEY=

# Optional: override the Claude model.
# anthropic.model=claude-haiku-4-5-20251001

# Optional: force mock mode even with a key present (useful for offline demos).
# MOCK_AI=true

# Auth — the single seeded user. Defaults to yash.s / labtech if not set.
# Change APP_SEED_PASSWORD before deploying to anything public.
APP_SEED_USERNAME=yash.s
APP_SEED_PASSWORD=labtech
APP_SEED_DISPLAY_NAME=Lab Tech

# -------- Production / Railway deployment --------
# Set these on the Railway backend service. Locally you can ignore them.
#
# SPRING_PROFILES_ACTIVE=prod
#   Activates application-prod.properties → SameSite=None, Secure cookies.
#
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
#   Railway Postgres plugin exposes this automatically. The backend's
#   DatabaseUrlEnvironmentPostProcessor parses it into spring.datasource.*.
#
# APP_CORS_ALLOWED_ORIGINS=https://your-frontend.up.railway.app
#   Comma-separated list of allowed origins for the SPA. Exact scheme + host,
#   no trailing slash. Required for cross-origin session cookies to work.
#
# PORT is set automatically by Railway; the backend binds to it.
